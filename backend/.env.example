# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string. Local example:
MONGO_URI=mongodb://127.0.0.1:27017/ammo_chain
# Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ammo_chain

# Port the Express API listens on
PORT=5000

# Secret used to sign JWTs - change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Depot auto-replenishment threshold (rounds per ammo type, applied per depot/type
# unless overridden per-item in the Lot data)
DEFAULT_REPLENISH_THRESHOLD=500

# Degradation risk model
DEGRADATION_BASELINE_TEMP_C=25
DEGRADATION_RISK_ALERT_THRESHOLD=70

# Sensor simulator tick interval (ms) - how often background readings are generated
SENSOR_SIM_INTERVAL_MS=15000
SENSOR_SIM_ENABLED=true

{
  "name": "ammo-chain-backend",
  "version": "1.0.0",
  "description": "Blockchain-enabled smart contract based ammunition management system - MERN backend (custom hash-chained ledger, no external blockchain platform required)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "test:logic": "node scripts/testLogic.js",
    "test:merkle": "node scripts/testMerkle.js",
    "bench:merkle": "node scripts/benchMerkle.js",
    "test:offline": "node scripts/testOfflineSync.js",
    "test:outage": "node scripts/simulateOutage.js",
    "test": "node scripts/testLogic.js && node scripts/testMerkle.js && node scripts/testOfflineSync.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
